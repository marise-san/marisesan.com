---
import Base from '../layouts/Base.astro';
import AreaMark from '../components/ui/AreaMark.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import WorkRow from '../components/work/WorkRow.astro';
import Terminal from '../components/ui/Terminal.astro';
import Diagram from '../components/diagrams/Diagram.astro';
import { getContent } from '../content';
import { palette, semanticColors, areas, fonts, typeScale, space, shape, effects, kebab, type PaletteKey } from '../design/tokens';
import { contrastRatio, wcagLevel } from '../lib/contrast';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const content = getContent(lang);
const ds = content.ds;
const L = ds.labels;

const paper = palette.paper.value;
const ink = palette.ink.value;
const toSwatch = (key: PaletteKey) => {
  const { value, name } = palette[key];
  return {
    key, name, value,
    token: `--palette-${kebab(key)}`,
    onPaper: contrastRatio(value, paper),
    onInk: contrastRatio(value, ink),
  };
};
const paletteGroups = [
  { label: L.paletteBase, keys: ['ink', 'graphite', 'line', 'paper', 'white'] as PaletteKey[] },
  { label: L.paletteNeon, keys: ['cyan', 'magenta', 'yellow'] as PaletteKey[] },
  { label: L.paletteDeep, keys: ['cyanDeep', 'magentaDeep', 'yellowDeep'] as PaletteKey[] },
].map((g) => ({ label: g.label, swatches: g.keys.map(toSwatch) }));

const sizesPx = Object.entries(typeScale).map(([k, v]) => ({ k, v, px: Math.round(parseFloat(v) * 16) }));
const areaContent = content.areas;
const sampleItem = content.areas[2].items[0];
const diagrams = content.areas.flatMap((a) => (a.featured?.diagrams ?? []).map((d) => ({ d, k: kebab(a.key) })));
const layersD = diagrams.find((x) => x.d.kind === 'layers');
const pyramidD = diagrams.find((x) => x.d.kind === 'pyramid');
const flowD = diagrams.find((x) => x.d.kind === 'flow');
const glows = Object.keys(effects).filter((k) => k.startsWith('glow-'));
const fmt = (n: number) => n.toFixed(2).replace('.', lang === 'pt' ? ',' : '.');
---
<Base
  lang={lang}
  path="/design-system/"
  title={`${ds.title} | Marise Santana`}
  description={ds.lede}
  ogAlt={content.meta.ogAlt}
>
  <section class="intro band">
    <div class="wrap">
      <h1>{ds.title}</h1>
      <p class="lede">{ds.lede}</p>
      <p class="source"><code>{ds.sourceNote}</code></p>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-palette">
    <div class="wrap">
      <h2 id="ds-palette">{ds.sections.palette}</h2>
      <p class="section-text">{ds.sections.paletteText}</p>
      {paletteGroups.map((group) => (
      <h3 class="group-title">{group.label}</h3>
      <ul class="swatches">
        {group.swatches.map((s) => (
          <li class="swatch">
            <span class="chip" style={`background: var(${s.token})`}></span>
            <div class="swatch-body">
              <strong>{s.name}</strong>
              <code>{s.token}</code>
              <code class="muted">{s.value}</code>
              <dl>
                <div><dt>{L.contrastPaper}</dt><dd>{fmt(s.onPaper)} <span>{wcagLevel(s.onPaper)}</span></dd></div>
                <div><dt>{L.contrastInk}</dt><dd>{fmt(s.onInk)} <span>{wcagLevel(s.onInk)}</span></dd></div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      ))}
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-semantic">
    <div class="wrap">
      <h2 id="ds-semantic">{ds.sections.semantic}</h2>
      <p class="section-text">{ds.sections.semanticText}</p>
      <table class="tokens">
        <thead><tr><th>{L.token}</th><th>{L.value}</th><th>{L.use}</th></tr></thead>
        <tbody>
          {Object.entries(semanticColors).map(([key, { ref, use }]) => (
            <tr>
              <td data-l={L.token}><span class="dot" style={`background: var(--${key})`}></span><code>--{key}</code></td>
              <td data-l={L.value}><code>var(--palette-{kebab(ref)})</code></td>
              <td data-l={L.use}>{use[lang]}</td>
            </tr>
          ))}
        </tbody>
      </table>
<pre><code>{`.card {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}`}</code></pre>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-areas">
    <div class="wrap">
      <h2 id="ds-areas">{ds.sections.areas}</h2>
      <p class="section-text">{ds.sections.areasText}</p>
      <ul class="areas">
        {areaContent.map((a) => {
          const def = areas[a.key];
          return (
            <li style={`--deep: var(--area-${kebab(a.key)}-deep)`}>
              <AreaMark area={a.key} size="lg" />
              <div>
                <strong>{a.name}</strong>
                <code>--area-{kebab(a.key)}</code>
                <code>--area-{kebab(a.key)}-deep</code>
              </div>
              <p class="deep-sample">{ds.sampleText}</p>
              <p class="ratio">{fmt(contrastRatio(palette[def.deep].value, paper))} {wcagLevel(contrastRatio(palette[def.deep].value, paper))}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-type">
    <div class="wrap">
      <h2 id="ds-type">{ds.sections.type}</h2>
      <p class="section-text">{ds.sections.typeText}</p>
      <div class="families">
        {Object.entries(fonts).map(([key, f]) => (
          <div class="family">
            <p class="aa" style={`font-family: var(--font-${key})`}>Aa</p>
            <strong>{f.name}</strong>
            <code>--font-{key}</code>
            <p class="muted">{f.role[lang]}</p>
          </div>
        ))}
      </div>
      <ol class="scale">
        {sizesPx.slice().reverse().map((s) => (
          <li>
            <code>--text-{s.k}</code>
            <span class="px">{s.px}px</span>
            <span class="sample" style={`font-size: var(--text-${s.k})`}>{ds.sampleText}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-space">
    <div class="wrap split">
      <div>
        <h2 id="ds-space">{ds.sections.space}</h2>
        <p class="section-text">{ds.sections.spaceText}</p>
        <ol class="space">
          {Object.entries(space).map(([k, v]) => (
            <li><code>--space-{k}</code><span class="bar" style={`width: var(--space-${k})`}></span><span class="muted">{Math.round(parseFloat(v) * 16)}px</span></li>
          ))}
        </ol>
      </div>
      <div>
        <h2>{ds.sections.shape}</h2>
        <p class="section-text">{ds.sections.shapeText}</p>
        <ul class="shapes">
          {Object.entries(shape).filter(([k]) => k.startsWith('cut')).map(([k, v]) => (
            <li><span class="cut" style={`--c: var(--${k})`}></span><code>--{k}</code><span class="muted">{v}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="ds-effects">
    <div class="wrap">
      <h2 id="ds-effects">{ds.sections.effects}</h2>
      <p class="section-text">{ds.sections.effectsText}</p>
      <ul class="glows">
        {glows.map((g) => (
          <li><span class="glow-chip" style={`box-shadow: var(--${g}); background: var(--area-${g.replace('glow-', '')})`}></span><code>--{g}</code></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ds-section last" aria-labelledby="ds-components">
    <div class="wrap">
      <h2 id="ds-components">{ds.sections.components}</h2>
      <p class="section-text">{ds.sections.componentsText}</p>

      <div class="specimens">
        <div class="specimen">
          <p class="label">Button</p>
          <div class="row">
            <Button href="#ds-components">{L.buttonPrimary}</Button>
            <Button href="#ds-components" variant="ghost">{L.buttonSecondary}</Button>
          </div>
          <div class="row inverse">
            <Button href="#ds-components" variant="neon">{L.buttonPrimary}</Button>
          </div>
        </div>
        <div class="specimen">
          <p class="label">{L.tag}</p>
          <ul class="tag-list"><Tag>.NET</Tag><Tag>React</Tag><Tag>Python</Tag><Tag>llama.cpp</Tag></ul>
          <p class="label">{L.areaMark}</p>
          <div class="row">
            <AreaMark area="software" size="sm" />
            <AreaMark area="aiAssisted" size="md" />
            <AreaMark area="aiProducts" size="lg" />
          </div>
        </div>
      </div>

      <div class="specimen wide">
        <p class="label">{L.terminal}</p>
        <div class="terminal-wrap"><Terminal {...content.hero.terminal} /></div>
      </div>

      <div class="specimens diagrams">
        {layersD && <div class="specimen" style={`--area: var(--area-${layersD.k}); --area-deep: var(--area-${layersD.k}-deep)`}><p class="label">{L.layers}</p><Diagram diagram={layersD.d} /></div>}
        {pyramidD && <div class="specimen" style={`--area: var(--area-${pyramidD.k}); --area-deep: var(--area-${pyramidD.k}-deep)`}><p class="label">{L.pyramid}</p><Diagram diagram={pyramidD.d} /></div>}
      </div>
      {flowD && (
        <div class="specimen wide" style={`--area: var(--area-${flowD.k}); --area-deep: var(--area-${flowD.k}-deep)`}>
          <p class="label">{L.flow}</p>
          <Diagram diagram={flowD.d} />
        </div>
      )}

      <div class="specimen wide">
        <p class="label">{L.progress}</p>
        <p class="muted small">{L.progressText}</p>
        <div class="progress-demo" aria-hidden="true"><span></span></div>
      </div>

      <div class="specimen wide">
        <p class="label">{L.workItem}</p>
        <WorkRow item={sampleItem} />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-bottom: var(--space-7); border-bottom: 1px solid var(--color-border); }
  h1 { font-size: clamp(var(--text-3xl), 8vw, var(--text-5xl)); margin-bottom: var(--space-5); }
  .source code { background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-1) var(--space-2); }

  .ds-section { padding-block: var(--space-8) 0; }
  .ds-section.last { padding-bottom: var(--space-9); }
  .ds-section h2 { font-size: clamp(var(--text-xl), 3vw, var(--text-2xl)); margin-bottom: var(--space-3); }
  .section-text { color: var(--color-text-muted); font-size: var(--text-base); margin-bottom: var(--space-6); }
  .muted { color: var(--color-text-muted); }
  code { font-size: var(--text-sm); }

  .group-title { font-size: var(--text-md); margin: var(--space-6) 0 var(--space-3); }
  .swatches { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: var(--space-4); }
  .swatch { background: var(--color-surface); border: 1px solid var(--color-border); }
  .chip { display: block; height: 88px; border-bottom: 1px solid var(--color-border); clip-path: polygon(0 0, calc(100% - var(--cut-md)) 0, 100% var(--cut-md), 100% 100%, 0 100%); }
  .swatch-body { padding: var(--space-4); display: grid; gap: var(--space-1); }
  .swatch-body strong { font-family: var(--font-display); font-size: var(--text-md); }
  dl { margin: var(--space-3) 0 0; display: grid; gap: var(--space-1); font-size: var(--text-sm); }
  dl div { display: flex; justify-content: space-between; gap: var(--space-2); }
  dt { color: var(--color-text-muted); }
  dd { margin: 0; font-family: var(--font-mono); white-space: nowrap; }
  dd span { color: var(--color-text-muted); }

  .tokens { width: 100%; border-collapse: collapse; font-size: var(--text-base); background: var(--color-surface); border: 1px solid var(--color-border); }
  .tokens th, .tokens td { text-align: left; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); vertical-align: middle; }
  .tokens th { font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm); }
  .dot { display: inline-block; width: 14px; height: 14px; border: 1px solid var(--color-border); margin-right: var(--space-3); vertical-align: -2px; }
  pre { margin: var(--space-5) 0 0; padding: var(--space-5); background: var(--color-inverse); color: var(--color-on-inverse); overflow-x: auto; font-size: var(--text-sm); line-height: 1.6; }

  .areas { list-style: none; padding: 0; border-top: 1px solid var(--color-border); }
  .areas li { display: grid; grid-template-columns: auto minmax(0, 14rem) minmax(0, 1fr) auto; gap: var(--space-5); align-items: center; padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .areas div { display: grid; gap: var(--space-1); }
  .areas strong { font-family: var(--font-display); font-size: var(--text-lg); }
  .deep-sample { color: var(--deep); font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); margin: 0; }
  .ratio { font-family: var(--font-mono); font-size: var(--text-sm); margin: 0; white-space: nowrap; }

  .families { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin-bottom: var(--space-7); }
  .family { background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-5); display: grid; gap: var(--space-1); }
  .aa { font-size: var(--text-4xl); line-height: 1; margin: 0 0 var(--space-3); }
  .family strong { font-family: var(--font-display); font-size: var(--text-md); }
  .family p.muted { margin: var(--space-2) 0 0; font-size: var(--text-sm); }
  .scale { list-style: none; padding: 0; border-top: 1px solid var(--color-border); }
  .scale li { display: grid; grid-template-columns: 7.5rem 3.5rem minmax(0, 1fr); gap: var(--space-4); align-items: baseline; padding-block: var(--space-3); border-bottom: 1px solid var(--color-border); }
  .px { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-text-muted); }
  .sample { font-family: var(--font-display); font-weight: 700; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  .space, .shapes { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .space li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) 3rem; gap: var(--space-4); align-items: center; }
  .bar { height: 12px; background: var(--area-software); }
  .shapes { grid-template-columns: repeat(3, auto); justify-content: start; gap: var(--space-6); }
  .shapes li { display: grid; gap: var(--space-2); }
  .cut { width: 96px; height: 72px; background: var(--color-text); clip-path: polygon(0 0, calc(100% - var(--c)) 0, 100% var(--c), 100% 100%, 0 100%); }

  .specimens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .specimen { background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-5); }
  .specimen.wide { margin-top: var(--space-4); }
  .specimen .label { font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-3); }
  .specimen .tag-list { margin-bottom: var(--space-5); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
  .row.inverse { margin-top: var(--space-4); padding: var(--space-4); background: var(--color-inverse); }
  .diagrams { margin-top: var(--space-4); }
  .terminal-wrap { max-width: 34rem; }
  .small { font-size: var(--text-sm); }
  .progress-demo { height: 4px; background: var(--color-border); }
  .progress-demo span { display: block; height: 100%; width: 62%; background: linear-gradient(90deg, var(--area-software) 0 33.33%, var(--area-ai-assisted) 33.33% 66.66%, var(--area-ai-products) 66.66% 100%); background-size: 161% 100%; }
  .glows { list-style: none; padding: var(--space-6); margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-7); background: var(--color-inverse); color: var(--color-on-inverse); }
  .glows li { display: grid; gap: var(--space-3); justify-items: start; }
  .glow-chip { width: 72px; height: 40px; display: block; }

  @media (max-width: 820px) {
    .families, .specimens, .split { grid-template-columns: 1fr; }
    .areas li { grid-template-columns: auto minmax(0, 1fr); }
    .deep-sample, .ratio { grid-column: 2; }
    .scale li { grid-template-columns: 1fr auto; }
    .scale .sample { grid-column: 1 / -1; }
    .tokens thead { display: none; }
    .tokens tr { display: grid; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); }
    .tokens td { border: 0; padding: var(--space-1) 0; }
  }
</style>
