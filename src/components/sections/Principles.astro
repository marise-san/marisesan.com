---
import type { SiteContent } from '../../content/types';

interface Props { content: SiteContent }
const { principles } = Astro.props.content;
---
<section class="band" aria-labelledby="principles-title">
  <div class="wrap">
    <h2 id="principles-title">{principles.title}</h2>
    <div class="grid">
      {principles.items.map((p) => (
        <div class="item">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { margin-bottom: var(--space-7); }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .item {
    padding: var(--space-6);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  h3 { margin-bottom: var(--space-3); }
  p { margin: 0; color: var(--color-text-muted); font-size: var(--text-base); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
