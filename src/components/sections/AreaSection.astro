---
import type { Area } from '../../content/types';
import { kebab } from '../../design/tokens';
import AreaMark from '../ui/AreaMark.astro';
import WorkFeature from '../work/WorkFeature.astro';
import WorkRow from '../work/WorkRow.astro';

interface Props { area: Area }
const { area } = Astro.props;
const headingId = `${area.id}-title`;
const k = kebab(area.key);
---
<section id={area.id} class="area" aria-labelledby={headingId} style={`--area: var(--area-${k}); --area-deep: var(--area-${k}-deep)`}>
  <div class="wrap">
    <header class="head">
      <AreaMark area={area.key} size="lg" />
      <h2 id={headingId}>{area.name}</h2>
    </header>

    <div class="features">
      {area.featured.map((f) => <WorkFeature item={f} area={area.key} />)}
    </div>

    {area.items.length > 0 && (
      <div class="rows">
        {area.items.map((item) => <WorkRow item={item} />)}
      </div>
    )}
  </div>
</section>

<style>
  .area { padding-block: clamp(var(--space-8), 8vw, var(--space-9)) 0; }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--color-text);
  }
  h2 { font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl)); }
  .features { display: grid; gap: var(--space-6); }
  .rows { margin-top: var(--space-6); }
  .rows :global(.row:last-child) { border-bottom: 1px solid var(--color-border); }
  /* Ao passar o mouse em uma linha, as outras recuam. */
  @media (hover: hover) {
    .rows:has(:global(.row:hover)) :global(.row:not(:hover)) { opacity: 0.55; }
  }
</style>
