---
import type { SiteContent } from '../../content/types';
import AreaMark from '../ui/AreaMark.astro';
import Button from '../ui/Button.astro';
import { kebab } from '../../design/tokens';

interface Props { content: SiteContent }
const { hero, areas, areasTitle } = Astro.props.content;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="role">{hero.role}, {hero.location}</p>
    <h1 id="hero-title">{hero.name}</h1>
    <div class="spectrum" aria-hidden="true">
      {areas.map((a) => <span style={`--c: var(--area-${kebab(a.key)})`}></span>)}
    </div>

    <div class="grid">
      <div class="intro">
        <p class="lede">{hero.lede}</p>
        <div class="actions">
          <Button href="https://www.linkedin.com/in/marise-san/" external>{hero.primaryCta}</Button>
          <Button href="#areas" variant="ghost">{hero.secondaryCta}</Button>
        </div>
      </div>

      <nav class="index" aria-label={areasTitle}>
        <ol>
          {areas.map((a) => (
            <li>
              <a href={`#${a.id}`}>
                <AreaMark area={a.key} />
                <span class="name">{a.name}</span>
                <span class="short">{a.short}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(var(--space-7), 8vw, var(--space-9)) var(--space-6); }

  .role {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: clamp(var(--text-3xl), 10.5vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-wrap: nowrap;
  }

  /* Três segmentos: as três áreas, apresentadas logo abaixo do nome. */
  .spectrum {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    margin-block: var(--space-5) clamp(var(--space-7), 6vw, var(--space-8));
    max-width: 42rem;
  }
  .spectrum span { height: 10px; background: var(--c); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .spectrum span { transform: scaleX(0); animation: draw var(--duration-slow) var(--ease-out) forwards; }
    .spectrum span:nth-child(2) { animation-delay: 160ms; }
    .spectrum span:nth-child(3) { animation-delay: 320ms; }
    @keyframes draw { to { transform: scaleX(1); } }
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(var(--space-6), 6vw, var(--space-9));
    align-items: start;
  }
  .lede { font-size: var(--text-lg); color: var(--color-text); margin-bottom: var(--space-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); align-items: center; }

  .index ol { list-style: none; padding: 0; border-top: 1px solid var(--color-border); }
  .index li { border-bottom: 1px solid var(--color-border); }
  .index a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    padding-block: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }
  .index :global(.mark) { grid-row: span 2; margin-top: 0.3em; }
  .name { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); line-height: 1.2; }
  .short { color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.5; }
  .index a:hover .name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    h1 { text-wrap: balance; }
  }
</style>
