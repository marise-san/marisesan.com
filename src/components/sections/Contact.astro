---
import type { SiteContent } from '../../content/types';
import Button from '../ui/Button.astro';

interface Props { content: SiteContent }
const { contact } = Astro.props.content;
---
<section id="contact" class="contact band" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">{contact.title}</h2>
    <p>{contact.text}</p>
    <div class="actions">
      <Button href="https://www.linkedin.com/in/marise-san/" variant="neon" external>{contact.primaryCta}</Button>
      <a class="secondary" href="https://github.com/marise-san" rel="me noopener">{contact.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    position: relative;
    overflow: hidden;
  }
  /* As três cores das áreas fecham a página, como abriram. */
  .contact::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: linear-gradient(90deg,
      var(--area-software) 0 33.33%,
      var(--area-ai-assisted) 33.33% 66.66%,
      var(--area-ai-products) 66.66% 100%);
  }
  h2 { font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl)); max-width: 16ch; margin-bottom: var(--space-5); }
  p { font-size: var(--text-lg); color: var(--color-on-inverse); opacity: 0.85; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); margin-top: var(--space-6); }
  .secondary { color: var(--color-on-inverse); font-family: var(--font-display); font-weight: 600; }
  .contact :global(:focus-visible) { outline-color: var(--area-ai-products); }
</style>
