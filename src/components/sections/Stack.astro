---
import type { SiteContent } from '../../content/types';
import Tag from '../ui/Tag.astro';

interface Props { content: SiteContent }
const { stack } = Astro.props.content;
---
<section class="band" aria-labelledby="stack-title">
  <div class="wrap layout">
    <h2 id="stack-title">{stack.title}</h2>
    <div class="groups">
      {stack.groups.map((g) => (
        <div>
          <h3>{g.name}</h3>
          <ul class="tag-list">{g.items.map((i) => <Tag>{i}</Tag>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .band { padding-top: 0; }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-7);
  }
  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-7); }
  h3 { font-size: var(--text-md); margin-bottom: var(--space-3); }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  @media (max-width: 560px) { .groups { grid-template-columns: 1fr; } }
</style>
