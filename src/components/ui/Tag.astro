---
/** Rótulo de tecnologia. Use dentro de uma <ul class="tag-list">. */
---
<li class="tag"><slot /></li>

<style>
  .tag {
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  :global(.tag-list) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
  }
</style>
