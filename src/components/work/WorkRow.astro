---
/** Trabalho complementar de uma área, em linha. */
import type { WorkItem } from '../../content/types';
import Tag from '../ui/Tag.astro';

interface Props { item: WorkItem }
const { item } = Astro.props;
---
<article class="row">
  <div>
    <h3>{item.title}</h3>
    <p class="context">{item.context}</p>
  </div>
  <div>
    <p class="summary">{item.summary}</p>
    <ul class="tag-list">{item.tags.map((tag) => <Tag>{tag}</Tag>)}</ul>
  </div>
  <div class="link">
    {item.link && <a href={item.link.href} rel="noopener">{item.link.label}</a>}
  </div>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr) minmax(0, 6rem);
    gap: var(--space-3) var(--space-7);
    padding: var(--space-6) var(--space-5);
    border-top: 1px solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-out), opacity var(--duration-base) var(--ease-out);
  }
  /* Faixa na cor da área, que cresce ao passar o mouse ou focar um link da linha. */
  .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: 0;
    width: 4px;
    background: var(--area, var(--area-software));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .row:hover, .row:focus-within { background: var(--color-surface); }
  .row:hover::before, .row:focus-within::before { transform: scaleY(1); }

  h3 { font-size: var(--text-lg); }
  .context { font-size: var(--text-sm); color: var(--color-text-muted); margin: var(--space-2) 0 0; }
  .summary { font-size: var(--text-base); margin-bottom: var(--space-4); }
  .link { text-align: right; font-family: var(--font-display); font-weight: 600; font-size: var(--text-base); }
  @media (max-width: 820px) {
    .row { grid-template-columns: 1fr; padding-inline: var(--space-4); }
    .link { text-align: left; }
  }
</style>
